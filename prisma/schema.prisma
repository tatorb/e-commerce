// Modelo de datos de E-commerce Studio MRB.
//
// La regla central: el producto es la fuente única de verdad. Un canal
// (Mercado Libre, tienda web) solo muestra el producto a través de una
// Publicación. Nunca se guardan datos del producto "dentro" de la publicación
// salvo lo que es propio del canal (título, descripción y atributos tal como
// se muestran ahí, precio, ID externo).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // Trae cada registro con sus relaciones en una sola consulta, en lugar de
  // una por nivel: con la base lejos del servidor, cada consulta suma una ida
  // y vuelta.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Login (Better Auth) ─────────────────────────────
// Los usuarios son del equipo del estudio y ven todas las cuentas.

model User {
  id                 String               @id
  name               String
  email              String               @unique
  emailVerified      Boolean              @default(false)
  image              String?
  // Administrador: puede todo, ve todas las cuentas y maneja los usuarios.
  isAdmin            Boolean              @default(false)
  // Qué puede en cada sección (src/domain/access.ts): { "<sección>": "read" | "write" }.
  // Sin la sección, no la ve.
  permissions        Json                 @default("{}")
  // Dado de baja: no puede entrar. No se borra, así la actividad conserva su nombre.
  disabledAt         DateTime?
  // Entró con una contraseña que le dieron: tiene que cambiarla.
  mustChangePassword Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt
  accounts           UserAccount[]
  activity           ActivityLog[]
  sessions           Session[]
  authAccounts       AuthAccount[]
  stageMovements     StageMovement[]
  importRuns         ImportRun[]
  importMappings     ImportMapping[]
  proposals          Proposal[]           @relation("ProposalCreatedBy")
  decidedProposals   Proposal[]           @relation("ProposalDecidedBy")
  applications       ChannelApplication[]
  pipelineEntries    PipelineMovement[]   @relation("PipelineMovedIn")
  pipelineExits      PipelineMovement[]   @relation("PipelineMovedOut")
  titleLockChoices   TitleWork[]
  titleApprovals     TitleApproval[]
  titleRuleSets      TitleRuleSet[]
  connections        ChannelConnection[]
  connectAttempts    ConnectAttempt[]
  mcpCodes           McpAuthCode[]
  mcpTokens          McpToken[]
  researchEdits      ProductResearch[]
  uploadedFiles      ProductFile[]
  imageWorkers       ImageWorker[]
  photoSettings      PhotoSettings[]
  photoEdits         PhotoEdit[]
  photoDecisions     PhotoStepRun[]
  channelSyncs       ChannelSync[]
  syncChoices        ChannelSyncChange[]
  questionAnswers    BuyerQuestion[]
  questionDrafts     QuestionDraft[]
  driveConnections   DriveConnection[]    @relation("DriveConnectedBy")
  driveAttempts      DriveConnection[]    @relation("DriveAttemptBy")
  uploadedVideos     ProductVideo[]
  clipChoices        PublicationClip[]    @relation("ClipChosenBy")
  clipUploads        PublicationClip[]    @relation("ClipUploadedBy")
  descriptionDrafts  DescriptionDraft[]
  pricingSettings    PricingSettings[]    @relation("PricingSettingsUpdatedBy")
  priceDecisions     PriceDecision[]      @relation("PriceDecidedBy")
  tasksCreated       Task[]               @relation("TaskCreatedBy")
  tasks              TaskAssignee[]
  stockMoves         StockMovement[]
  shootProtocols     ShootProtocol[]      @relation("ShootProtocolCreatedBy")

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Credenciales de login de cada usuario. Better Auth lo llama "account"; acá
// se renombra para no confundirlo con Account, que es la cuenta del cliente.
model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// Las cuentas que ve cada usuario que no es administrador.
model UserAccount {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, accountId])
  @@index([accountId])
  @@map("user_accounts")
}

enum ActivityKind {
  // Guardó o cambió algo.
  CHANGE
  SIGN_IN
  SIGN_IN_FAILED
  SIGN_OUT
}

enum ActivitySource {
  APP
  // Claude, conectado con el usuario de la persona.
  CLAUDE
}

// Lo que hace cada persona en la app: cada cambio que guarda y cada ingreso.
// Lo que la app hace sola queda en el Registro, no acá.
model ActivityLog {
  id            Int            @id @default(autoincrement())
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  // En un ingreso fallido, el email que escribió.
  email         String?
  accountId     String?
  account       Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  kind          ActivityKind
  // La sección de la app (src/domain/access.ts), o "equipo".
  section       String?
  // Qué hizo, en una frase: "Aprobó el título".
  summary       String
  // Sobre qué: los códigos y cómo se llamaba en ese momento, por si después se borra.
  publicationId String?
  productId     String?
  targetLabel   String?
  // Un dato más, por ejemplo el título que aprobó.
  detail        String?
  via           ActivitySource @default(APP)
  createdAt     DateTime       @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([accountId, createdAt])
  @@map("activity_logs")
}

// ───────────────────────────── Cuentas y canales ─────────────────────────────

// Cuenta: el cliente del estudio. Todo dato pertenece a una cuenta.
model Account {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  timezone            String               @default("America/Argentina/Buenos_Aires")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  stores              Store[]
  products            Product[]
  importMappings      ImportMapping[]
  importRuns          ImportRun[]
  standardRules       StandardRule[]
  titleRuleSets       TitleRuleSet[]
  suggestions         SearchSuggestion[]
  photoSettings       PhotoSettings?
  questionSettings    QuestionSettings?
  descriptionSettings DescriptionSettings?
  members             UserAccount[]
  activity            ActivityLog[]
  pricingSettings     PricingSettings?
  tasks               Task[]
  shootProtocols      ShootProtocol[]

  @@map("accounts")
}

enum ChannelKind {
  MERCADOLIBRE
  WEB_STORE
}

// Canal: lista fija de lugares donde se puede mostrar un producto.
model Channel {
  id            String             @id @default(cuid())
  kind          ChannelKind        @unique
  name          String
  stores        Store[]
  standardRules StandardRule[]
  titleRuleSets TitleRuleSet[]
  suggestions   SearchSuggestion[]
  probes        ChannelProbe[]

  @@map("channels")
}

// Forma de llevar una publicación aprobada al canal. Hoy es manual; mañana
// puede ser una planilla masiva o la API del canal, sin tocar el resto.
enum ApplyMethod {
  MANUAL
  SPREADSHEET
  API
}

// Tienda: la presencia de una cuenta en un canal. Por ejemplo, Insur en
// Mercado Libre es la tienda INSURMOTOR.
model Store {
  id               String             @id @default(cuid())
  accountId        String
  account          Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channelId        String
  channel          Channel            @relation(fields: [channelId], references: [id])
  name             String
  externalSellerId String?
  applyMethod      ApplyMethod        @default(MANUAL)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  publications     Publication[]
  importRuns       ImportRun[]
  connection       ChannelConnection?
  connectAttempts  ConnectAttempt[]
  probes           ChannelProbe[]
  syncs            ChannelSync[]
  buyerQuestions   BuyerQuestion[]
  questionReader   QuestionReader?

  // Desde cuándo la app lee las ventas de la tienda. Sin esto, o con un error,
  // sus publicaciones siguen a su canal y no al stock del producto.
  salesSince     DateTime?
  // Hasta dónde revisó las ventas la tarea de cada hora.
  salesCheckedAt DateTime?
  // Por qué no se pueden leer, por ejemplo porque falta el permiso.
  salesError     String?
  sales          ChannelSale[]
  families       ListingFamily[]

  @@unique([accountId, channelId, name])
  @@map("stores")
}

// ───────────────────────────── Producto (ficha maestra) ─────────────────────────────

// De dónde vino un registro: cargado a mano o por el importador.
enum RecordSource {
  MANUAL
  IMPORT
}

// Individual: se vende tal cual. Combo: se arma con productos individuales
// (ComboItem). En el canal los dos son publicaciones del mismo nivel.
enum ProductKind {
  INDIVIDUAL
  COMBO
}

model Product {
  id               String           @id @default(cuid())
  accountId        String
  account          Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name             String
  kind             ProductKind      @default(INDIVIDUAL)
  brand            String? // marca del repuesto
  partNumber       String? // nº de pieza u OEM
  productType      String? // tipo de producto, por ejemplo "Kit de embrague"
  engineSystem     String? // sistema del motor, por ejemplo "Distribución"
  line             String? // línea, por ejemplo "Liviano nafta"
  origin           String? // país de origen
  warranty         String?
  kitContents      String?
  // Lo que cuesta reponerlo, sin IVA: la base del precio.
  replacementCost  Decimal?         @db.Decimal(14, 2)
  // Los parámetros del precio que cambian solo para este producto; lo demás sigue a la cuenta.
  pricingOverrides Json             @default("{}")
  // Ficha técnica: lista de { name, value }.
  specs            Json             @default("[]")
  notes            String?
  source           RecordSource     @default(MANUAL)
  // Importación que lo creó, para poder deshacerla.
  importRunId      String?
  importRun        ImportRun?       @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  variants         ProductVariant[]
  compatibilities  Compatibility[]
  assets           Asset[]
  publications     Publication[]
  families         ListingFamily[]
  importChanges    ImportChange[]
  research         ProductResearch?
  files            ProductFile[]
  insights         BuyerInsight[]
  // Si es combo, los productos que lo forman.
  comboItems       ComboItem[]      @relation("ComboItems")
  // Si es individual, los combos de los que forma parte.
  inCombos         ComboItem[]      @relation("ComboComponent")
  photoEdits       PhotoEdit[]
  videos           ProductVideo[]

  // Desde cuándo la app maneja su stock: sus publicaciones lo heredan. Null:
  // cada publicación sigue a su canal (src/domain/stock.ts).
  stockSince  DateTime?
  // Algo para revisar del stock, por ejemplo que al empezar sus publicaciones
  // tenían cantidades distintas.
  stockReview String?
  stock       ProductStock[]
  stockMoves  StockMovement[]

  @@index([accountId])
  @@index([importRunId])
  @@map("products")
}

// Un producto individual dentro de un combo, con su cantidad. Borrar el combo
// borra su lista; un individual que está en un combo no se puede borrar.
model ComboItem {
  id        String  @id @default(cuid())
  comboId   String
  combo     Product @relation("ComboItems", fields: [comboId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation("ComboComponent", fields: [productId], references: [id], onDelete: NoAction)
  quantity  Int     @default(1)
  position  Int     @default(0)

  @@unique([comboId, productId])
  @@index([productId])
  @@map("combo_items")
}

// Variante por medida, por ejemplo STD, 0.25 o 0.50, cada una con su SKU.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  measure   String?
  sku       String?
  position  Int     @default(0)

  @@index([productId])
  @@map("product_variants")
}

model Compatibility {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleBrand String?
  model        String?
  engine       String?
  // Cilindrada, por ejemplo "1.9", y combustible, por ejemplo "Diesel".
  displacement String?
  fuel         String?
  yearFrom     Int?
  yearTo       Int?
  note         String?
  position     Int     @default(0)

  @@index([productId])
  @@map("compatibilities")
}

enum AssetKind {
  PHOTO
  VIDEO
}

// Activo: foto o video del producto. En el MVP solo se guarda el link.
model Asset {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      AssetKind
  url       String
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([productId])
  @@map("assets")
}

// ───────────────────────────── Publicación y etapas ─────────────────────────────

// Estado de la publicación dentro del canal.
enum ChannelStatus {
  ACTIVE
  PAUSED
  // Finalizada: ya no se vende. Se puede republicar o eliminar.
  CLOSED
  // El canal la está revisando: mientras tanto no se puede cambiar.
  UNDER_REVIEW
  // Otros casos del canal, por ejemplo pendiente de pago o de activarse.
  INACTIVE
  // Se eliminó en el canal. Queda en la app, archivada, con su historial.
  DELETED
  UNPUBLISHED
}

// Estado del recorrido de la propuesta completa con IA (el botón "Generar
// propuesta con IA"). Ya no es la etapa de la publicación: esa es la del
// pipeline, más abajo.
enum Stage {
  IMPORTED
  PROPOSAL_GENERATED
  IN_REVIEW
  APPROVED
  APPLIED
  MEASURED
}

// Publicación: el producto armado para una tienda puntual.
model Publication {
  id                String               @id @default(cuid())
  productId         String
  product           Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId           String
  store             Store                @relation(fields: [storeId], references: [id])
  externalId        String? // por ejemplo MLA123456
  url               String?
  title             String?
  description       String?
  // Atributos tal como se cargan en el canal: lista de { name, value }.
  attributes        Json                 @default("[]")
  // Las preguntas de los compradores en esta publicación, pegadas tal cual.
  // Las de la competencia son del producto (ProductResearch).
  ownQuestions      String?
  // Paso Preguntas y respuestas: las preguntas frecuentes con su respuesta y
  // las reglas de cuándo responde Claude y cuándo una persona, en HTML limpio.
  faq               String?
  answerRules       String?
  // Claude manda solo las respuestas que está seguro de que están bien.
  autoAnswer        Boolean              @default(false)
  // El precio publicado, como lo decide el paso Precio o lo trae el canal.
  price             Decimal?             @db.Decimal(14, 2)
  // Las cuotas: 0 sin cuotas, 1 la cuota promocionada, o 3, 6, 9 o 12 sin
  // interés. Null mientras no se leyó del canal.
  installments      Int?
  // El descuento sobre el precio publicado, en %. 0 sin descuento; null mientras no se leyó.
  discount          Decimal?             @db.Decimal(5, 2)
  // Las cantidades disponibles que se cambiaron en la app y faltan subir: una
  // lista de { key, label, quantity }, una por medida o una sola sin medidas.
  // Null: sigue a las del canal.
  quantities        Json?
  currency          String               @default("ARS")
  channelStatus     ChannelStatus        @default(ACTIVE)
  // Estado de la propuesta completa con IA.
  stage             Stage                @default(IMPORTED)
  // Pipeline: dónde está y en qué paso. El paso se conserva al sacarla del
  // pipeline, para retomar ahí si se vuelve a agregar.
  pipelineStatus    PipelineStatus       @default(UNTOUCHED)
  pipelineStep      PipelineStep?
  pipelineRemoval   PipelineRemoval?
  // Título bloqueado marcado a mano, para cuando no hay datos de ventas.
  titleLockedManual Boolean?
  // La categoría del canal, cuando se elige a mano. Sin elegir, sale de la
  // familia del producto (src/channels/<canal>/).
  channelCategory   String?
  // Las fotos de la publicación, en orden (src/domain/media.ts). Sin elegir,
  // son las que tiene en el canal. Cada foto puede ser de algunas medidas.
  media             Json?
  // De qué medidas es cada video del producto en esta publicación:
  // { "<id del video>": ["sku:..."] }. Sin marcar, el video es de todas.
  videoVariants     Json                 @default("{}")
  // Cuando el canal guarda cada medida como una publicación aparte, agrupadas
  // en una familia: el código, el SKU y la medida de cada una, en el orden de
  // la ficha. La primera es externalId. Vacío: una sola publicación en el canal.
  variantListings   Json                 @default("[]")
  // Si la cantidad en el canal se actualiza sola con el stock del producto.
  // Apagado, se cambia a mano en la publicación; sus ventas igual descuentan.
  followsStock      Boolean              @default(true)
  // La familia, cuando el canal guarda cada medida como una publicación aparte
  // y las agrupa (src/lib/families.ts). Sin familia: una publicación suelta.
  familyId          String?
  family            ListingFamily?       @relation("FamilyMembers", fields: [familyId], references: [id], onDelete: SetNull)
  // La familia de la que es la principal: ahí se guarda el trabajo del pipeline.
  leadOf            ListingFamily?       @relation("FamilyLead")
  // La medida que vende, cuando vende una sola: la clave de src/domain/media.ts
  // (variantKey). Null: vende todas, o todavía no se sabe.
  variantKey        String?
  // En una familia: la medida tiene su propio precio y no sigue al de la familia.
  ownPrice          Boolean              @default(false)
  source            RecordSource         @default(MANUAL)
  // Importación que la creó, para poder deshacerla.
  importRunId       String?
  importRun         ImportRun?           @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  stageMovements    StageMovement[]
  measurements      Measurement[]
  importChanges     ImportChange[]
  proposals         Proposal[]
  applications      ChannelApplication[]
  pipelineMovements PipelineMovement[]
  competitors       CompetitorListing[]
  titleWork         TitleWork?
  titleApprovals    TitleApproval[]
  positions         SearchPosition[]
  channelCopy       ChannelCopy?
  syncChanges       ChannelSyncChange[]
  buyerQuestions    BuyerQuestion[]
  priceDecisions    PriceDecision[]
  clips             PublicationClip[]
  descriptionDraft  DescriptionDraft?
  tasks             TaskPublication[]
  stockMoves        StockMovement[]

  @@unique([storeId, externalId])
  @@index([pipelineStatus])
  @@index([productId])
  @@index([importRunId])
  @@index([familyId])
  @@map("publications")
}

// La familia: las publicaciones de un producto en una tienda, una por medida,
// cuando el canal guarda cada medida aparte y las agrupa. Se trabajan juntas
// en el pipeline: lo que es de la familia (el paso, el título, la descripción,
// los datos de catálogo, las preguntas frecuentes, las reglas del bot y el
// precio) se guarda igual en todas, y cada una tiene su código, su cantidad,
// sus fotos y su estado (src/lib/families.ts).
model ListingFamily {
  id              String        @id @default(cuid())
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  // El código de la familia en el canal, tal cual lo da. Null mientras no se creó allá.
  channelFamilyId String?
  // La publicación principal: ahí vive el trabajo del pipeline, y lo terminado
  // se copia a las demás.
  leadId          String?       @unique
  lead            Publication?  @relation("FamilyLead", fields: [leadId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  members         Publication[] @relation("FamilyMembers")

  @@unique([storeId, channelFamilyId])
  @@index([productId])
  @@map("listing_families")
}

// Registro de cuándo entra y sale una publicación de cada etapa. Una sola
// fila abierta (exitedAt nulo) por publicación: la etapa actual.
model StageMovement {
  id            String      @id @default(cuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  stage         Stage
  enteredAt     DateTime    @default(now())
  exitedAt      DateTime?
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([publicationId, enteredAt])
  @@map("stage_movements")
}

// ───────────────────────────── Mediciones ─────────────────────────────

// Medición: foto de cómo estaba una publicación en el canal en una fecha.
// Sirve como "antes" para comparar con el "después" de aplicar los cambios.
// Las métricas son una lista abierta (src/domain/measurements.ts) para no
// rehacer la tabla cada vez que se mide algo nuevo.
model Measurement {
  id            String       @id @default(cuid())
  publicationId String
  publication   Publication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  takenAt       DateTime     @db.Date
  source        RecordSource @default(MANUAL)
  metrics       Json         @default("{}")
  importRunId   String?
  importRun     ImportRun?   @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([publicationId, takenAt])
  @@index([importRunId])
  @@map("measurements")
}

// ───────────────────────────── Importador ─────────────────────────────

// Relación guardada entre las columnas de un archivo y los campos de la app.
model ImportMapping {
  id          String      @id @default(cuid())
  accountId   String
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  // Encabezados del archivo con el que se armó, para reconocerlo después.
  headers     Json        @default("[]")
  // Encabezado → campo de la app.
  fields      Json        @default("{}")
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  importRuns  ImportRun[]

  @@unique([accountId, name])
  @@map("import_mappings")
}

enum ImportStatus {
  RUNNING
  DONE
  FAILED
  UNDONE
}

// Qué hace una importación con lo que ya está en la app: solo completa lo
// vacío, o además reemplaza lo que es distinto.
enum ImportUpdateMode {
  FILL_EMPTY
  REPLACE
}

// De dónde vienen las filas: un archivo, o el canal leído con la cuenta conectada.
enum ImportOrigin {
  FILE
  CHANNEL_API
}

// Una importación: quién, cuándo, qué archivo y qué resultó.
model ImportRun {
  id                   String           @id @default(cuid())
  accountId            String
  account              Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  storeId              String
  store                Store            @relation(fields: [storeId], references: [id])
  mappingId            String?
  mapping              ImportMapping?   @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  userId               String?
  user                 User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  origin               ImportOrigin     @default(FILE)
  // Con origin CHANNEL_API, el canal y la tienda.
  fileName             String
  sheetName            String
  dataDate             DateTime         @db.Date
  status               ImportStatus     @default(RUNNING)
  rowsTotal            Int
  rowsProcessed        Int              @default(0)
  productsCreated      Int              @default(0)
  publicationsCreated  Int              @default(0)
  publicationsLinked   Int              @default(0)
  publicationsExisting Int              @default(0)
  measurementsSaved    Int              @default(0)
  updateMode           ImportUpdateMode @default(FILL_EMPTY)
  // Publicaciones o fichas que ya estaban y a las que se les cambió algo.
  publicationsUpdated  Int              @default(0)
  fieldsChanged        Int              @default(0)
  rowsWithErrors       Int              @default(0)
  // Primeros errores, para mostrarlos: lista de { row, message }.
  errors               Json             @default("[]")
  startedAt            DateTime         @default(now())
  finishedAt           DateTime?
  undoneAt             DateTime?
  // Productos que creó y quedaron al deshacer: tenían publicaciones cargadas
  // después o estaban en un combo.
  productsKept         Int              @default(0)
  products             Product[]
  publications         Publication[]
  measurements         Measurement[]
  changes              ImportChange[]

  @@index([accountId, startedAt])
  @@map("import_runs")
}

// ───────────────────────────── Estándar de publicación ─────────────────────────────

// Regla del estándar, por cuenta y canal. "check" es una de las revisiones
// que la app sabe hacer (src/domain/standard.ts) y "params" sus valores,
// por ejemplo { "min": 6 } fotos.
model StandardRule {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id])
  name        String
  description String?
  check       String
  params      Json     @default("{}")
  weight      Int      @default(10)
  active      Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId, channelId, position])
  @@map("standard_rules")
}

// Un campo que una importación cambió en algo que ya estaba: cómo estaba y
// cómo quedó. Deshacer la importación lo devuelve, si nadie lo cambió después.
model ImportChange {
  id            Int          @id @default(autoincrement())
  importRunId   String
  importRun     ImportRun    @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Solo en los campos de la publicación, como el título.
  publicationId String?
  publication   Publication? @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  field         String
  before        Json?
  after         Json?
  createdAt     DateTime     @default(now())

  @@index([importRunId])
  @@index([productId])
  @@map("import_changes")
}

// ───────────────────────────── Propuestas de la IA ─────────────────────────────

enum ProposalStatus {
  ACTIVE // la vigente de la publicación, una sola a la vez
  SUPERSEDED // reemplazada por otra más nueva
  APPROVED
  REJECTED
}

// Propuesta de la IA para una publicación: qué cambiaría, campo por campo.
// No cambia nada por sí sola: se revisa y se aprueba aparte.
model Proposal {
  id            String               @id @default(cuid())
  publicationId String
  publication   Publication          @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  status        ProposalStatus       @default(ACTIVE)
  summary       String
  // Campos que cambian: lista de { field, before, after, reason, toConfirm, placeholders }.
  fields        Json
  // Cómo estaba el contenido cuando se generó, para comparar en la revisión.
  baseline      Json
  // Avisos generales, por ejemplo una medida de un SKU que no está en el producto.
  notes         Json                 @default("[]")
  model         String
  // Tokens y costo aproximado en dólares.
  usage         Json
  createdById   String?
  createdBy     User?                @relation("ProposalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  // Revisión: mientras se revisa, el borrador; al decidir, qué quedó en cada
  // campo, qué había propuesto la IA, si se editó y cómo estaba antes.
  review        Json?
  decidedAt     DateTime?
  decidedById   String?
  decidedBy     User?                @relation("ProposalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  rejectReason  String?
  applications  ChannelApplication[]

  @@index([publicationId, status])
  @@map("proposals")
}

// ───────────────────────────── Aplicación en el canal ─────────────────────────────

// Cada vez que lo aprobado se aplicó en el canal: cuándo, cómo y qué campos.
// La fecha es el punto de partida para medir el antes y el después.
model ChannelApplication {
  id            String      @id @default(cuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  proposalId    String?
  proposal      Proposal?   @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  method        ApplyMethod
  appliedAt     DateTime
  // Campos aplicados: lista de claves, por ejemplo ["title", "specs"].
  fields        Json        @default("[]")
  createdById   String?
  createdBy     User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([publicationId, appliedAt])
  @@map("channel_applications")
}

// ───────────────────────────── Pipeline ─────────────────────────────

// Pasos del pipeline, en orden (src/domain/pipeline.ts).
enum PipelineStep {
  INFO
  TITLE
  IMAGES
  VIDEOS
  MEDIA
  DESCRIPTION
  QA
  PRICE
  PUBLISH
}

enum PipelineStatus {
  UNTOUCHED // sin tocar
  IN_PIPELINE
  CORRECTED // terminó el último paso
  DISCARDED // se sacó del pipeline, con su motivo
}

// Por qué salió de un paso.
enum PipelineExit {
  ADVANCED
  BACK
  REMOVED
  COMPLETED
}

// Motivo al sacarla del pipeline.
enum PipelineRemoval {
  NOT_WORTH
  LATER
  DUPLICATE
  PAUSE
}

// Cuándo entra y sale una publicación de cada paso, quién la movió y por qué
// salió. Una sola fila abierta (exitedAt nulo) mientras está en el pipeline.
model PipelineMovement {
  id            String           @id @default(cuid())
  publicationId String
  publication   Publication      @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  step          PipelineStep
  enteredAt     DateTime         @default(now())
  userId        String?
  user          User?            @relation("PipelineMovedIn", fields: [userId], references: [id], onDelete: SetNull)
  exitedAt      DateTime?
  exitKind      PipelineExit?
  removal       PipelineRemoval?
  exitedById    String?
  exitedBy      User?            @relation("PipelineMovedOut", fields: [exitedById], references: [id], onDelete: SetNull)

  @@index([publicationId, enteredAt])
  @@map("pipeline_movements")
}

// ───────────────────────────── Paso Información ─────────────────────────────

// Publicación de la competencia que vende mucho, cargada a mano. Sus títulos
// suman palabras al mapa del paso Título, y su precio, descuento, cuotas y
// envío sirven para comparar precios.
model CompetitorListing {
  id            String      @id @default(cuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  url           String?
  title         String
  soldQuantity  Int?
  sellerName    String?
  // La marca del producto que vende: sin ella, comparar el precio dice poco.
  brand         String?
  // El precio antes de cualquier descuento.
  listPrice     Decimal?    @db.Decimal(14, 2)
  // El descuento activo en %, por ejemplo 15 para 15 %.
  discountPct   Decimal     @default(0) @db.Decimal(5, 2)
  // Cuotas sin interés: 0 es sin cuotas; si no, 3, 6, 9 o 12.
  installments  Int         @default(0)
  freeShipping  Boolean     @default(false)
  // El día en que se miró el precio: cambia seguido.
  surveyedAt    DateTime?   @db.Date
  notes         String?
  position      Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([publicationId])
  @@map("competitor_listings")
}

// La investigación del producto que se junta en el paso Información: lo del
// fabricante, las aclaraciones para las imágenes y las preguntas de los
// compradores. Es del producto: la comparten todas sus publicaciones.
model ProductResearch {
  id                     String   @id @default(cuid())
  productId              String   @unique
  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  manufacturerSite       String?
  manufacturerProductUrl String?
  manufacturerText       String?
  // Texto con formato, en HTML limpio: solo negrita, cursiva y listas.
  clarifications         String?
  // Lo que sabe la tienda del producto: contexto, preguntas frecuentes,
  // condiciones que pueden surgir y sus aclaraciones. Texto con formato, como clarifications.
  storeKnowledge         String?
  competitorQuestions    String?
  updatedById            String?
  updatedBy              User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt              DateTime @updatedAt

  @@map("product_research")
}

enum ProductFileKind {
  IMAGE
  PDF
}

// Un archivo del fabricante subido al depósito de archivos.
model ProductFile {
  id           String          @id @default(cuid())
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind         ProductFileKind
  name         String
  contentType  String
  size         Int
  url          String          @unique
  uploadedById String?
  uploadedBy   User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())

  @@index([productId])
  @@map("product_files")
}

enum InsightKind {
  PAIN
  OBJECTION
}

// Un dolor o una objeción de los compradores, en el orden que se eligió.
model BuyerInsight {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      InsightKind
  text      String
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([productId, kind, position])
  @@map("buyer_insights")
}

// ───────────────────────────── Paso Título ─────────────────────────────

// Reglas de título por cuenta y canal. Sin fila, valen las del canal
// (src/channels/<canal>/).
model TitleRuleSet {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channelId      String
  channel        Channel  @relation(fields: [channelId], references: [id])
  maxLength      Int?
  // Signos no permitidos, todos juntos, por ejemplo "!¡*$".
  forbiddenChars String   @default("")
  // Palabras o frases no permitidas: lista de textos.
  forbiddenWords Json     @default("[]")
  // Estructura sugerida por familia: lista de { family, structure }. La
  // familia vacía vale para todas.
  structures     Json     @default("[]")
  updatedById    String?
  updatedBy      User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt      DateTime @updatedAt

  @@unique([accountId, channelId])
  @@map("title_rule_sets")
}

// Qué hacer con un título bloqueado por ventas.
enum TitleLockDecision {
  KEEP // mantener el título: el paso se completa sin cambios
  TRY_IN_COPY // probar el título nuevo en la copia con cuotas
}

// El trabajo del paso Título de una publicación: semillas, palabras elegidas,
// búsquedas principales y propuestas de la IA.
model TitleWork {
  id              String             @id @default(cuid())
  publicationId   String             @unique
  publication     Publication        @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  lockDecision    TitleLockDecision?
  lockDecidedAt   DateTime?
  lockDecidedById String?
  lockDecidedBy   User?              @relation(fields: [lockDecidedById], references: [id], onDelete: SetNull)
  // Lo que se busca en el canal: lista de textos.
  seeds           Json?
  // Palabra → "use" o "discard".
  words           Json               @default("{}")
  // Búsquedas principales para medir la posición: lista de textos.
  mainSearches    Json               @default("[]")
  // Propuestas de la IA: lista de { title, reason }.
  proposals       Json               @default("[]")
  proposalsAt     DateTime?
  proposalUsage   Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("title_works")
}

enum TitleOutcome {
  KEPT // se mantuvo el título
  WRITTEN // el título nuevo quedó en la publicación
  COPY // el título nuevo es para la copia con cuotas
}

// Cada título aprobado: cómo estaba, qué quedó, qué propuso la IA y si la
// persona lo cambió.
model TitleApproval {
  id            String       @id @default(cuid())
  publicationId String
  publication   Publication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  outcome       TitleOutcome
  before        String?
  title         String?
  // La propuesta de la IA que se eligió, si se eligió una.
  aiTitle       String?
  // Las propuestas que había: lista de { title, reason }.
  aiProposals   Json         @default("[]")
  edited        Boolean      @default(false)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([publicationId, createdAt])
  @@map("title_approvals")
}

enum CaptureSource {
  AUTO // leído por la app
  MANUAL // pegado o cargado a mano
}

// Sugerencias del buscador del canal para lo que se escribió, con fecha. Son
// de la cuenta: sirven para todas las publicaciones con la misma semilla.
model SearchSuggestion {
  id            String        @id @default(cuid())
  accountId     String
  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channelId     String
  channel       Channel       @relation(fields: [channelId], references: [id])
  // La semilla y lo que se escribió en el buscador: la semilla, o la semilla
  // más una letra.
  seed          String
  query         String
  // Lista de textos, en el orden del buscador.
  suggestions   Json
  source        CaptureSource
  publicationId String?
  capturedAt    DateTime      @default(now())

  @@index([accountId, channelId, seed])
  @@map("search_suggestions")
}

// En qué página y posición aparece la publicación al buscar algo, con fecha.
// Sin página: no aparece en las páginas revisadas.
model SearchPosition {
  id            String        @id @default(cuid())
  publicationId String
  publication   Publication   @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  query         String
  page          Int?
  position      Int?
  pagesChecked  Int           @default(3)
  source        CaptureSource
  checkedAt     DateTime      @default(now())

  @@index([publicationId, checkedAt])
  @@map("search_positions")
}

// Prueba de conexión con un canal: si la app puede leer cada cosa.
model ChannelProbe {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id])
  // Las pruebas con la cuenta conectada son de una tienda; las demás, del canal.
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  check     String
  ok        Boolean
  detail    String
  checkedAt DateTime @default(now())

  @@index([channelId, check, checkedAt])
  @@map("channel_probes")
}

// ───────────────────────────── Conexión con el canal ─────────────────────────────

enum ConnectionStatus {
  NOT_CONNECTED // hay datos de la aplicación, todavía sin autorizar
  ACTIVE
  NEEDS_REAUTH // la renovación falló: hay que volver a autorizar
}

// La conexión de una tienda con su canal por API. Cada cliente crea su propia
// aplicación en el canal y la autoriza con su cuenta. Las claves y las llaves
// se guardan cifradas (src/lib/crypto.ts) y nunca se muestran.
model ChannelConnection {
  id               String           @id @default(cuid())
  storeId          String           @unique
  store            Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // La aplicación del cliente en el canal.
  appId            String
  appSecret        String
  // Los últimos 4 caracteres de la clave secreta, para reconocerla.
  appSecretHint    String
  status           ConnectionStatus @default(NOT_CONNECTED)
  // La cuenta del canal que autorizó.
  externalUserId   String?
  externalNickname String?
  accessToken      String?
  refreshToken     String?
  expiresAt        DateTime?
  scope            String?
  connectedAt      DateTime?
  connectedById    String?
  connectedBy      User?            @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  lastRefreshAt    DateTime?
  lastError        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("channel_connections")
}

// Un pedido de autorización en curso. El código de control (state) va y
// vuelve del canal, y dice de qué tienda era. Se usa una sola vez y vence.
model ConnectAttempt {
  id           String    @id @default(cuid())
  state        String    @unique
  // El secreto de PKCE, cifrado.
  codeVerifier String
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([storeId])
  @@map("connect_attempts")
}

// ───────────────────────────── Conexión con Claude (MCP) ─────────────────────────────

// Un programa que pidió conectarse, por ejemplo Claude en claude.ai. Se
// registra solo la primera vez (registro dinámico de OAuth).
model McpClient {
  id           String        @id
  name         String?
  // Direcciones de vuelta que declaró: lista de textos.
  redirectUris Json          @default("[]")
  createdAt    DateTime      @default(now())
  codes        McpAuthCode[]
  tokens       McpToken[]

  @@map("mcp_clients")
}

// El código que recibe Claude cuando la persona toca Autorizar. Se cambia por
// la llave una sola vez y vence a los 10 minutos. Se guarda solo su huella.
model McpAuthCode {
  id            String     @id @default(cuid())
  codeHash      String     @unique
  clientId      String?
  client        McpClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime   @default(now())
  tokens        McpToken[]

  @@map("mcp_auth_codes")
}

// La llave con la que Claude usa la app en nombre de una persona. Vale 30
// días y se puede cortar desde Equipo. Se guarda solo su huella.
model McpToken {
  id         String       @id @default(cuid())
  tokenHash  String       @unique
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId   String?
  client     McpClient?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName String
  codeId     String?
  code       McpAuthCode? @relation(fields: [codeId], references: [id], onDelete: SetNull)
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())

  @@index([userId])
  @@map("mcp_tokens")
}

// ───────────────────────────── Paso Imágenes ─────────────────────────────

// El trabajador de imágenes: el programa que corrige las fotos en la Mac del
// estudio (trabajador-imagenes/). Es uno solo para todo el estudio y entra con
// su propia llave, de la que se guarda solo la huella. Crear una llave nueva
// corta la anterior.
model ImageWorker {
  id          String         @id @default(cuid())
  keyHash     String         @unique
  // Los últimos 4 caracteres de la llave, para reconocerla.
  keyHint     String
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  revokedAt   DateTime?
  // Su última señal y lo que contó en ella: versión, modelo del fondo, memoria y avisos.
  lastSeenAt  DateTime?
  info        Json?
  runs        PhotoStepRun[]

  @@map("image_workers")
}

// Los valores de la línea de imágenes de una cuenta: margen, fondo, calidad y
// topes. Sin fila, valen los de src/domain/photo-settings.ts.
model PhotoSettings {
  id          String   @id @default(cuid())
  accountId   String   @unique
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  values      Json
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@map("photo_settings")
}

enum PhotoSource {
  UPLOAD // el original, subido desde la Mac
  CHANNEL // la foto publicada en el canal
}

// Una foto del producto en la línea de corrección. El original queda en el
// depósito y nunca se toca. Es del producto: la ven todas sus publicaciones.
model PhotoEdit {
  id           String         @id @default(cuid())
  productId    String
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  source       PhotoSource
  originalUrl  String         @unique
  originalName String
  originalType String
  originalSize Int
  // De dónde se bajó, si es del canal.
  channelUrl   String?
  // Lo que anota el trabajador al prepararla: la vista liviana, el tamaño y la cámara.
  previewUrl   String?
  width        Int?
  height       Int?
  camera       Json?
  position     Int            @default(0)
  // Ya viene editada: se usa el original tal cual, sin pasar por la Mac ni por Claude.
  asIs         Boolean        @default(false)
  // Sacada de la lista. El original sigue en el depósito.
  archivedAt   DateTime?
  createdById  String?
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  runs         PhotoStepRun[]
  // Sacada en Registro de productos: se suma sola a las publicaciones del
  // producto cuando está lista (placedAt, cuándo se sumó).
  shot         Boolean        @default(false)
  placedAt     DateTime?
  // El paso del protocolo que siguió, si siguió uno.
  shootStepId  String?
  shootStep    ShootStep?     @relation(fields: [shootStepId], references: [id], onDelete: SetNull)
  // La medida que eligió el operario (variantKey) y cómo se llamaba. Sin medida: todas.
  variantKey   String?
  variantLabel String?

  @@index([productId, position])
  @@index([shot, placedAt])
  @@map("photo_edits")
}

enum PhotoRunStatus {
  QUEUED // en cola
  PROCESSING // el trabajador lo tomó
  REVIEW // esperando aprobación
  APPROVED
  SKIPPED
  FAILED // falló 3 veces
  REPLACED // se rehízo este paso o uno anterior
}

// Cada intento de un paso de una foto. Un paso tiene varios ajustes que la
// Mac hace de corrido: lo pedido, lo que propuso Claude, lo que se usó y lo que
// midió el código se guardan por ajuste. La cola de trabajo está en
// src/lib/photo-queue.ts.
model PhotoStepRun {
  id          String         @id @default(cuid())
  editId      String
  edit        PhotoEdit      @relation(fields: [editId], references: [id], onDelete: Cascade)
  // El paso: 0 Corregir la foto, 1 Recortar y exportar (src/domain/photo-steps.ts).
  step        Int
  status      PhotoRunStatus @default(QUEUED)
  // El id de la foto mientras el intento está abierto: en cola, en proceso,
  // esperando aprobación o fallido. Así hay uno solo abierto por foto.
  openFor     String?        @unique
  // Lo que pidió la persona al rehacer: { valores, apagados, propuestas }.
  // Sin pedido, propone Claude.
  requested   Json?
  // Copia de los ajustes de la cuenta con los que corre.
  settings    Json
  // Lo que devolvió el trabajador en cada ajuste: lista de partes
  // (src/domain/photo-contract.ts).
  parts       Json?
  previewUrl  String?
  maskUrl     String?
  pngUrl      String?
  jpgUrl      String?
  // El paquete para editar la foto en vivo (src/domain/photo-live.ts).
  liveUrl     String?
  aiUsage     Json?
  seconds     Float?
  // El turno: sube cada vez que el trabajador lo toma. Un resultado con otro
  // turno es de un intento viejo y no se acepta.
  lease       Int            @default(0)
  leaseUntil  DateTime?
  workerId    String?
  worker      ImageWorker?   @relation(fields: [workerId], references: [id], onDelete: SetNull)
  attempts    Int            @default(0)
  error       String?
  decidedById String?
  decidedBy   User?          @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([editId, step])
  @@map("photo_step_runs")
}

// ───────────────────────────── Sincronización con el canal ─────────────────────────────

// La cara de una publicación en el canal: lo último que se leyó de allá. Junto
// con lo que tiene la app y lo último en que las dos coincidieron, dice de qué
// lado cambió cada dato (src/domain/channel-sync.ts).
model ChannelCopy {
  publicationId     String        @id
  publication       Publication   @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  readAt            DateTime
  // Cuándo cambió por última vez en el canal, según el canal.
  channelUpdatedAt  DateTime?
  // La descripción se pide aparte: solo si la publicación cambió o pasó un día.
  descriptionReadAt DateTime?
  // Desde cuándo el canal no la devuelve: se borró o es de otra cuenta.
  missingSince      DateTime?
  title             String?
  description       String?
  // Los datos de catálogo como los guarda la app: lista de { name, value }.
  attributes        Json          @default("[]")
  price             Decimal?      @db.Decimal(14, 2)
  installments      Int?
  discount          Decimal?      @db.Decimal(5, 2)
  // Hasta cuándo dura el descuento que subió la app: antes de que venza se renueva solo.
  discountUntil     DateTime?
  // Cuándo lo subió: un rato después, si el canal todavía no lo muestra, se espera.
  discountSentAt    DateTime?
  // La cantidad disponible en total; la de cada medida va en variations.
  quantity          Int?
  // El canal maneja el stock, como en Full: la cantidad no se cambia desde la app.
  stockInChannel    Boolean       @default(false)
  status            ChannelStatus
  url               String?
  photos            Json          @default("[]")
  // El código de cada foto en el canal, en el mismo orden, y de qué foto
  // corregida salió cada una que subió la app: { "<código>": "<id de la foto>" }.
  photoIds          Json          @default("[]")
  photoOrigins      Json          @default("{}")
  // Cada variante de la publicación en el canal, con el código de sus fotos:
  // lista de { sku, measure, photoIds }.
  variations        Json          @default("[]")
  hasVideo          Boolean       @default(false)
  // Marca, número de pieza, origen y SKU, como los informa el canal.
  details           Json          @default("{}")
  // La categoría en el canal, y el código de cada dato de catálogo por su
  // nombre en la app: { "tipo de embrague": { id, multiple } }. Sirven para
  // subir los datos de catálogo.
  categoryId        String?
  attributeIds      Json          @default("{}")
  // Huella de cada dato en el canal, y de lo último en que coincidieron con la
  // app. Un dato sin huella acordada todavía no se sabe de qué lado está bien.
  fingerprints      Json          @default("{}")
  agreed            Json          @default("{}")
  // Lo que el canal no aceptó al subir, por dato: { title: { message, at, fingerprint } }.
  // Vale mientras la app tenga el mismo valor que se intentó subir.
  rejections        Json          @default("{}")
  updatedAt         DateTime      @updatedAt

  @@map("channel_copies")
}

enum SyncTrigger {
  SCHEDULE
  MANUAL
}

enum SyncStatus {
  RUNNING
  DONE
  FAILED
}

// Una pasada de lectura de una tienda. Se hace por tandas, en uno o varios
// pedidos: guarda hasta dónde llegó para seguir en el próximo.
model ChannelSync {
  id           String              @id @default(cuid())
  storeId      String
  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  trigger      SyncTrigger
  userId       String?
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  status       SyncStatus          @default(RUNNING)
  startedAt    DateTime            @default(now())
  finishedAt   DateTime?
  // Mientras un pedido la está corriendo, nadie más la toma.
  leaseUntil   DateTime?
  // Los códigos de las publicaciones a leer y cuántos ya se leyeron.
  ids          Json                @default("[]")
  position     Int                 @default(0)
  total        Int                 @default(0)
  read         Int                 @default(0)
  // Publicaciones con datos que llegaron del canal.
  updated      Int                 @default(0)
  // Publicaciones que el canal no devolvió.
  missing      Int                 @default(0)
  // Al terminar: cuántas quedan para elegir y cuántas hay en el canal que no están en la app.
  toChoose     Int?
  newInChannel Int?
  errors       Json                @default("[]")
  changes      ChannelSyncChange[]

  @@index([storeId, startedAt])
  @@map("channel_syncs")
}

enum SyncChangeKind {
  // Cambió en el canal y la app no tenía un cambio propio: se tomó.
  TAKEN
  // Era distinto en los dos lados y alguien eligió.
  CHOSE_CHANNEL
  CHOSE_APP
  // Se subió al canal lo de la app.
  SENT
  // Se descartó el cambio de la app y volvió lo del canal.
  DISCARDED
  // Se creó la publicación en el canal desde la app.
  CREATED
  // Se intentó subir y no se pudo: el motivo queda en message.
  REJECTED
  // Se intentó crear en el canal y no se pudo.
  CREATE_FAILED
  // Se respondió desde la app la pregunta de un comprador.
  ANSWERED
  // Se intentó responder y no se pudo.
  ANSWER_FAILED
  // Se cambió el estado en el canal desde la app: pausar, reactivar, finalizar o eliminar.
  STATUS_CHANGED
  // Se intentó cambiar el estado y no se pudo.
  STATUS_FAILED
  // Se republicó una finalizada: quedó con otro código en el canal.
  RELISTED
  // El descuento que había subido la app estaba por vencer y se volvió a subir solo.
  RENEWED
}

// Un dato que cambió por la sincronización: lo que llegó del canal, lo que se
// eligió, lo que se subió o el borrador que se descartó.
model ChannelSyncChange {
  id            Int            @id @default(autoincrement())
  syncId        String?
  sync          ChannelSync?   @relation(fields: [syncId], references: [id], onDelete: SetNull)
  publicationId String
  publication   Publication    @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  field         String
  kind          SyncChangeKind
  before        Json?
  after         Json?
  // Por qué no se pudo, en los intentos que fallaron.
  message       String?
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())

  @@index([publicationId, createdAt])
  @@index([syncId])
  @@index([createdAt])
  @@map("channel_sync_changes")
}

// ───────────────────────────── Preguntas de los compradores ─────────────────────────────

enum QuestionStatus {
  UNANSWERED
  ANSWERED
  // Ya no se puede responder: la publicación se cerró.
  CLOSED
  // El canal la borró, la bloqueó o la está revisando.
  REMOVED
}

// Una pregunta que hizo un comprador en el canal, con su respuesta si la
// tiene. Llega con el aviso del canal o con la lectura de cada hora.
model BuyerQuestion {
  id            String         @id @default(cuid())
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // El código de la pregunta en el canal.
  externalId    String
  // El código de la publicación en el canal. publicationId, si está en la app.
  listingId     String
  publicationId String?
  publication   Publication?   @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  text          String
  status        QuestionStatus
  askedAt       DateTime
  // Solo el código del comprador en el canal, para juntar sus preguntas.
  buyerId       String?
  answer        String?
  answeredAt    DateTime?
  // Desde dónde se respondió, y quién si fue desde la app.
  answeredFrom  AnswerSource?
  answeredById  String?
  answeredBy    User?          @relation(fields: [answeredById], references: [id], onDelete: SetNull)
  draft         QuestionDraft?
  // La última vez que se leyó del canal.
  readAt        DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([storeId, externalId])
  @@index([storeId, status, askedAt])
  @@index([publicationId, askedAt])
  @@index([storeId, listingId])
  @@map("buyer_questions")
}

// Cómo va la lectura de las preguntas de cada tienda.
model QuestionReader {
  storeId        String    @id
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // Mientras un pedido está leyendo, nadie más lee.
  leaseUntil     DateTime?
  // La pregunta más nueva que se leyó: las lecturas siguientes paran cerca de ahí.
  newestAt       DateTime?
  // Por dónde va la carga de las preguntas anteriores. Null cuando terminó.
  historyOffset  Int?      @default(0)
  historyTotal   Int?
  // El canal no deja traer más atrás.
  historyLimited Boolean   @default(false)
  readAt         DateTime?
  lastError      String?
  // El último aviso del canal: muestra que la dirección de avisos está bien cargada.
  noticeAt       DateTime?

  @@map("question_readers")
}

enum AnswerSource {
  // Se respondió en el canal, fuera de la app.
  CHANNEL
  APP
}

enum DraftOutcome {
  SENT_AS_IS
  SENT_EDITED
  DISCARDED
  // Alguien respondió en el canal, fuera de la app.
  ANSWERED_IN_CHANNEL
  // Claude la mandó solo: la publicación lo deja y estaba seguro.
  SENT_AUTO
}

// La respuesta que propuso Claude para una pregunta, y qué se hizo con ella:
// así se mide cuánto se usa tal cual antes de pensar en responder solo.
model QuestionDraft {
  id          String        @id @default(cuid())
  questionId  String        @unique
  question    BuyerQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text        String
  // De qué trata la pregunta, por ejemplo compatibilidad o stock.
  kind        String
  // Los datos que usó y los que le faltaron, en frases cortas.
  usedData    Json          @default("[]")
  missing     Json          @default("[]")
  // Depende de algo que la app no sabe: tiene que responder una persona.
  needsPerson Boolean       @default(false)
  reason      String?
  model       String
  usage       Json
  // Lo que costaron todas las propuestas de esta pregunta, en dólares.
  costUsd     Float
  attempts    Int           @default(1)
  outcome     DraftOutcome?
  // Lo que se mandó al final, si se corrigió.
  sentText    String?
  decidedAt   DateTime?
  decidedById String?
  decidedBy   User?         @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([outcome, createdAt])
  @@map("question_drafts")
}

// Cómo responde cada cuenta: lo que Claude usa para proponer.
model QuestionSettings {
  accountId String   @id
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  greeting  String?
  signature String?
  tone      String?
  // Lo que Claude tiene que saber de la tienda: envíos, facturas, cómo se leen las medidas.
  notes     String?
  // Proponer respuestas solas cuando llega una pregunta.
  autoDraft Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("question_settings")
}

// ───────────────────────────── Google Drive y videos ─────────────────────────────

// La conexión del estudio con su Google Drive, donde se guardan los videos.
// Es una sola para todo el estudio. El cliente de Google lo crea el estudio
// en su proyecto de Google Cloud; la clave secreta y las llaves se guardan
// cifradas (src/lib/crypto.ts) y nunca se muestran.
model DriveConnection {
  id               String           @id @default("estudio")
  clientId         String
  clientSecret     String
  // Los últimos 4 caracteres de la clave secreta, para reconocerla.
  clientSecretHint String
  status           ConnectionStatus @default(NOT_CONNECTED)
  // La cuenta de Google que autorizó.
  email            String?
  accessToken      String?
  refreshToken     String?
  expiresAt        DateTime?
  scope            String?
  connectedAt      DateTime?
  connectedById    String?
  connectedBy      User?            @relation("DriveConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)
  lastRefreshAt    DateTime?
  lastError        String?
  // El pedido de permiso en curso: el código de control va y vuelve de
  // Google; el secreto de PKCE queda acá, cifrado. Se usa una sola vez.
  pendingState     String?          @unique
  pendingVerifier  String?
  pendingUntil     DateTime?
  pendingById      String?
  pendingBy        User?            @relation("DriveAttemptBy", fields: [pendingById], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("drive_connections")
}

// Las carpetas que armó la app en el Drive, por clave: "raiz", "cuenta:<id>",
// "producto:<id>" y "videos:<id del producto>". Si alguien borra una, la app
// la vuelve a crear.
model DriveFolder {
  key       String   @id
  folderId  String
  // La cuenta de Google donde está: si se conecta otra, no sirve.
  email     String
  createdAt DateTime @default(now())

  @@map("drive_folders")
}

enum VideoOrigin {
  APP // subido desde la app
  DRIVE // agregado a la carpeta desde el Drive, por ejemplo desde la Mac
}

// Un video del producto, guardado en su carpeta del Drive. Es del producto:
// lo ven todas sus publicaciones. La app guarda solo los datos; el archivo
// está en el Drive.
model ProductVideo {
  id             String            @id @default(cuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  driveFileId    String            @unique
  name           String
  mimeType       String
  size           BigInt?
  // Ancho y alto como se ve, y duración. Los mide el navegador; mientras no
  // los mida, valen los que informa Google cuando termina de procesarlo.
  width          Int?
  height         Int?
  durationMs     Int?
  measuredBy     String?
  webViewLink    String?
  origin         VideoOrigin
  uploadedById   String?
  uploadedBy     User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  driveCreatedAt DateTime?
  // Ya no está en la carpeta: se borró o se movió en el Drive.
  goneAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  clips          PublicationClip[]
  // Grabado en Registro de productos, con el paso del protocolo y la medida.
  shot           Boolean           @default(false)
  shootStepId    String?
  shootStep      ShootStep?        @relation(fields: [shootStepId], references: [id], onDelete: SetNull)
  variantKey     String?
  variantLabel   String?

  @@index([productId])
  @@map("product_videos")
}

// Un clip elegido para una publicación, y la marca de que ya se subió a mano
// al canal: Mercado Libre no deja subir clips por API. Una publicación puede
// tener varios, en orden: el primero es el que el canal muestra antes.
model PublicationClip {
  publicationId String
  publication   Publication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  videoId       String
  video         ProductVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  position      Int          @default(0)
  chosenById    String?
  chosenBy      User?        @relation("ClipChosenBy", fields: [chosenById], references: [id], onDelete: SetNull)
  chosenAt      DateTime     @default(now())
  uploadedAt    DateTime?
  uploadedById  String?
  uploadedBy    User?        @relation("ClipUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@id([publicationId, videoId])
  @@index([videoId])
  @@map("publication_clips")
}

// ───────────────────────────── Registro de productos ─────────────────────────────

enum ShootKind {
  PHOTO
  VIDEO
}

// Un protocolo para sacar las fotos y los videos de un producto: los pasos que
// sigue el operario en Registro de productos. Es de la cuenta.
model ShootProtocol {
  id          String      @id @default(cuid())
  accountId   String
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  description String      @default("")
  position    Int         @default(0)
  // Archivado: no se ofrece, pero lo que se sacó con él sigue anotado.
  archivedAt  DateTime?
  createdById String?
  createdBy   User?       @relation("ShootProtocolCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  steps       ShootStep[]

  @@index([accountId, position])
  @@map("shoot_protocols")
}

// Un paso del protocolo: qué sacar, foto o video, cómo, y una ilustración.
model ShootStep {
  id               String         @id @default(cuid())
  protocolId       String
  protocol         ShootProtocol  @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  position         Int            @default(0)
  title            String
  kind             ShootKind      @default(PHOTO)
  explanation      String         @default("")
  // La ilustración, en el Drive (drive:<id>), con su tipo y su nombre.
  illustrationUrl  String?
  illustrationType String?
  illustrationName String?
  // Sacado del protocolo: lo que se sacó con él sigue anotado.
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  photos           PhotoEdit[]
  videos           ProductVideo[]

  @@index([protocolId, position])
  @@map("shoot_steps")
}

// ───────────────────────────── Descripciones ─────────────────────────────

// La última propuesta de descripción de Claude para una publicación. Es solo
// el cuerpo: el encabezado y el pie de la cuenta los agrega la app. Lo que se
// usa va al borrador de la descripción de la publicación.
model DescriptionDraft {
  publicationId String      @id
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  text          String
  // Lo que Claude marcó [A CONFIRMAR] y los datos que usó, en frases cortas.
  toConfirm     Json        @default("[]")
  usedData      Json        @default("[]")
  model         String
  usage         Json
  // Lo que costaron todas las propuestas de esta publicación, en dólares.
  costUsd       Float
  attempts      Int         @default(1)
  createdById   String?
  createdBy     User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("description_drafts")
}

// El encabezado y el pie fijos de las descripciones de una cuenta, y lo que
// Claude tiene que saber para escribirlas.
model DescriptionSettings {
  accountId  String   @id
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  header     String?
  footer     String?
  guidelines String?
  updatedAt  DateTime @updatedAt

  @@map("description_settings")
}

// ───────────────────────────── Precio ─────────────────────────────

// Los parámetros para calcular el precio en la cuenta: cargos, impuestos,
// cuotas, envío y márgenes. Lo que no está guardado toma el valor de partida
// (src/domain/pricing.ts).
model PricingSettings {
  accountId   String   @id
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  values      Json     @default("{}")
  updatedById String?
  updatedBy   User?    @relation("PricingSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@map("pricing_settings")
}

// El precio que se decidió en el paso Precio para una publicación: el precio
// publicado, el descuento, las cuotas y el margen que dejaba con el costo y los
// parámetros de ese momento. Se guarda cada decisión: la última es la que vale.
model PriceDecision {
  id                String      @id @default(cuid())
  publicationId     String
  publication       Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  listPrice         Decimal     @db.Decimal(14, 2)
  discountPct       Decimal     @default(0) @db.Decimal(5, 2)
  // Cuotas sin interés: 0 es sin cuotas.
  installments      Int         @default(0)
  finalPrice        Decimal     @db.Decimal(14, 2)
  cost              Decimal     @db.Decimal(14, 2)
  marginPct         Decimal     @db.Decimal(8, 2)
  minMarginPct      Decimal     @db.Decimal(6, 2)
  // Los parámetros que se usaron, para saber de dónde salió el margen.
  params            Json
  // Quedó debajo del margen mínimo y se confirmó igual.
  belowMinConfirmed Boolean     @default(false)
  decidedById       String?
  decidedBy         User?       @relation("PriceDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt         DateTime    @default(now())

  @@index([publicationId, decidedAt])
  @@map("price_decisions")
}

// ───────────────────────────── Tareas ─────────────────────────────
// Lo que tiene que hacer alguien del equipo en una cuenta, sobre ninguna, una
// o varias publicaciones (src/domain/tasks.ts).

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  SUSPENDED
}

model Task {
  id                String            @id @default(cuid())
  accountId         String
  account           Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title             String
  description       String            @default("")
  status            TaskStatus        @default(PENDING)
  // Cuándo avisarles a sus personas, en la app y por mail.
  remindAt          DateTime?
  // El día en que tiene que estar terminada. Vence al terminar ese día, en la
  // zona horaria de la cuenta.
  dueOn             DateTime?         @db.Date
  // Cuándo salió el mail del aviso y el de vencida. Cambiar la fecha los
  // vuelve a programar.
  remindedAt        DateTime?
  overdueNotifiedAt DateTime?
  // Cuándo pasó a finalizada.
  doneAt            DateTime?
  createdById       String?
  createdBy         User?             @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  // Las que crea la app sola, por ejemplo "reactivar:<id de la publicación>":
  // no se repite una abierta con la misma clave y se cierra sola cuando ya no hace falta.
  autoKey           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  assignees         TaskAssignee[]
  publications      TaskPublication[]

  @@index([accountId, status])
  @@index([remindAt])
  @@index([dueOn])
  @@index([autoKey])
  @@map("tasks")
}

// Las personas de una tarea. Al menos una.
model TaskAssignee {
  taskId     String
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Cuándo salió el mail de que se la asignaron.
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

// Las publicaciones de una tarea. Puede no tener ninguna.
model TaskPublication {
  taskId        String
  task          Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@id([taskId, publicationId])
  @@index([publicationId])
  @@map("task_publications")
}

// ───────────────────────────── Stock ─────────────────────────────
// El stock es del producto: sus publicaciones lo heredan, y las ventas del
// canal lo descuentan (src/domain/stock.ts, src/lib/stock.ts).

model ProductStock {
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // La medida: su clave (quantityKey en src/domain/quantities.ts), o vacía si
  // el producto no tiene medidas. Así no se pierde si se vuelve a guardar la ficha.
  key       String
  // Cómo se llamaba la medida, para mostrarla aunque cambie la ficha.
  label     String   @default("")
  // Puede quedar negativo si se vendió más de lo que había.
  quantity  Int
  updatedAt DateTime @updatedAt

  @@id([productId, key])
  @@map("product_stock")
}

enum StockMoveKind {
  // El de partida, tomado del canal.
  INITIAL
  SALE
  // Una venta cancelada: las unidades vuelven.
  CANCEL
  // Un cambio a mano.
  MANUAL
}

model StockMovement {
  id            Int           @id @default(autoincrement())
  productId     String
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  key           String
  kind          StockMoveKind
  // Cuánto cambió y cuánto quedó.
  delta         Int
  after         Int
  publicationId String?
  publication   Publication?  @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  saleId        String?
  sale          ChannelSale?  @relation(fields: [saleId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime      @default(now())

  @@index([productId, createdAt])
  @@map("stock_movements")
}

enum SaleStatus {
  // Se descontó del stock.
  COUNTED
  // Se canceló antes de entregarse: las unidades volvieron.
  RETURNED
  // Se canceló ya entregada: no vuelve sola.
  KEPT
  // No tocó el stock: Full, un producto sin stock en la app o una cancelada antes de contarse.
  SKIPPED
}

// Una venta del canal, para no contarla dos veces y devolverla si se cancela.
model ChannelSale {
  id        String          @id @default(cuid())
  storeId   String
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // El código de la venta en el canal.
  orderId   String
  status    SaleStatus
  // Lo de cada línea: { publicationId, productId, key, quantity, counted, reason }.
  lines     Json            @default("[]")
  orderedAt DateTime
  delivered Boolean         @default(false)
  // Cuándo se leyó del canal por última vez.
  checkedAt DateTime
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  moves     StockMovement[]

  @@unique([storeId, orderId])
  @@index([status, checkedAt])
  @@map("channel_sales")
}
