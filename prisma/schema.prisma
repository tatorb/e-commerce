// Modelo de datos de E-commerce Studio MRB.
//
// La regla central: el producto es la fuente única de verdad. Un canal
// (Mercado Libre, tienda web) solo muestra el producto a través de una
// Publicación. Nunca se guardan datos del producto "dentro" de la publicación
// salvo lo que es propio del canal (título, descripción y atributos tal como
// se muestran ahí, precio, ID externo).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Login (Better Auth) ─────────────────────────────
// Los usuarios son del equipo del estudio y ven todas las cuentas.

model User {
  id               String               @id
  name             String
  email            String               @unique
  emailVerified    Boolean              @default(false)
  image            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now()) @updatedAt
  sessions         Session[]
  authAccounts     AuthAccount[]
  stageMovements   StageMovement[]
  importRuns       ImportRun[]
  importMappings   ImportMapping[]
  proposals        Proposal[]           @relation("ProposalCreatedBy")
  decidedProposals Proposal[]           @relation("ProposalDecidedBy")
  applications     ChannelApplication[]
  pipelineEntries  PipelineMovement[]   @relation("PipelineMovedIn")
  pipelineExits    PipelineMovement[]   @relation("PipelineMovedOut")
  titleLockChoices TitleWork[]
  titleApprovals   TitleApproval[]
  titleRuleSets    TitleRuleSet[]
  connections      ChannelConnection[]
  connectAttempts  ConnectAttempt[]
  mcpCodes         McpAuthCode[]
  mcpTokens        McpToken[]
  researchEdits    ProductResearch[]
  uploadedFiles    ProductFile[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Credenciales de login de cada usuario. Better Auth lo llama "account"; acá
// se renombra para no confundirlo con Account, que es la cuenta del cliente.
model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ───────────────────────────── Cuentas y canales ─────────────────────────────

// Cuenta: el cliente del estudio. Todo dato pertenece a una cuenta.
model Account {
  id             String             @id @default(cuid())
  slug           String             @unique
  name           String
  timezone       String             @default("America/Argentina/Buenos_Aires")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  stores         Store[]
  products       Product[]
  importMappings ImportMapping[]
  importRuns     ImportRun[]
  standardRules  StandardRule[]
  titleRuleSets  TitleRuleSet[]
  suggestions    SearchSuggestion[]

  @@map("accounts")
}

enum ChannelKind {
  MERCADOLIBRE
  WEB_STORE
}

// Canal: lista fija de lugares donde se puede mostrar un producto.
model Channel {
  id            String             @id @default(cuid())
  kind          ChannelKind        @unique
  name          String
  stores        Store[]
  standardRules StandardRule[]
  titleRuleSets TitleRuleSet[]
  suggestions   SearchSuggestion[]
  probes        ChannelProbe[]

  @@map("channels")
}

// Forma de llevar una publicación aprobada al canal. Hoy es manual; mañana
// puede ser una planilla masiva o la API del canal, sin tocar el resto.
enum ApplyMethod {
  MANUAL
  SPREADSHEET
  API
}

// Tienda: la presencia de una cuenta en un canal. Por ejemplo, Insur en
// Mercado Libre es la tienda INSURMOTOR.
model Store {
  id               String             @id @default(cuid())
  accountId        String
  account          Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channelId        String
  channel          Channel            @relation(fields: [channelId], references: [id])
  name             String
  externalSellerId String?
  applyMethod      ApplyMethod        @default(MANUAL)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  publications     Publication[]
  importRuns       ImportRun[]
  connection       ChannelConnection?
  connectAttempts  ConnectAttempt[]
  probes           ChannelProbe[]

  @@unique([accountId, channelId, name])
  @@map("stores")
}

// ───────────────────────────── Producto (ficha maestra) ─────────────────────────────

// De dónde vino un registro: cargado a mano o por el importador.
enum RecordSource {
  MANUAL
  IMPORT
}

// Individual: se vende tal cual. Combo: se arma con productos individuales
// (ComboItem). En el canal los dos son publicaciones del mismo nivel.
enum ProductKind {
  INDIVIDUAL
  COMBO
}

model Product {
  id              String           @id @default(cuid())
  accountId       String
  account         Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name            String
  kind            ProductKind      @default(INDIVIDUAL)
  brand           String? // marca del repuesto
  partNumber      String? // nº de pieza u OEM
  productType     String? // tipo de producto, por ejemplo "Kit de embrague"
  engineSystem    String? // sistema del motor, por ejemplo "Distribución"
  line            String? // línea, por ejemplo "Liviano nafta"
  origin          String? // país de origen
  warranty        String?
  kitContents     String?
  // Ficha técnica: lista de { name, value }.
  specs           Json             @default("[]")
  notes           String?
  source          RecordSource     @default(MANUAL)
  // Importación que lo creó, para poder deshacerla.
  importRunId     String?
  importRun       ImportRun?       @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  variants        ProductVariant[]
  compatibilities Compatibility[]
  assets          Asset[]
  publications    Publication[]
  importChanges   ImportChange[]
  research        ProductResearch?
  files           ProductFile[]
  insights        BuyerInsight[]
  // Si es combo, los productos que lo forman.
  comboItems      ComboItem[]      @relation("ComboItems")
  // Si es individual, los combos de los que forma parte.
  inCombos        ComboItem[]      @relation("ComboComponent")

  @@index([accountId])
  @@index([importRunId])
  @@map("products")
}

// Un producto individual dentro de un combo, con su cantidad. Borrar el combo
// borra su lista; un individual que está en un combo no se puede borrar.
model ComboItem {
  id        String  @id @default(cuid())
  comboId   String
  combo     Product @relation("ComboItems", fields: [comboId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation("ComboComponent", fields: [productId], references: [id], onDelete: NoAction)
  quantity  Int     @default(1)
  position  Int     @default(0)

  @@unique([comboId, productId])
  @@index([productId])
  @@map("combo_items")
}

// Variante por medida, por ejemplo STD, 0.25 o 0.50, cada una con su SKU.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  measure   String?
  sku       String?
  position  Int     @default(0)

  @@index([productId])
  @@map("product_variants")
}

model Compatibility {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleBrand String?
  model        String?
  engine       String?
  // Cilindrada, por ejemplo "1.9", y combustible, por ejemplo "Diesel".
  displacement String?
  fuel         String?
  yearFrom     Int?
  yearTo       Int?
  note         String?
  position     Int     @default(0)

  @@index([productId])
  @@map("compatibilities")
}

enum AssetKind {
  PHOTO
  VIDEO
}

// Activo: foto o video del producto. En el MVP solo se guarda el link.
model Asset {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      AssetKind
  url       String
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([productId])
  @@map("assets")
}

// ───────────────────────────── Publicación y etapas ─────────────────────────────

// Estado de la publicación dentro del canal.
enum ChannelStatus {
  ACTIVE
  PAUSED
  INACTIVE
  UNPUBLISHED
}

// Estado del recorrido de la propuesta completa con IA (el botón "Generar
// propuesta con IA"). Ya no es la etapa de la publicación: esa es la del
// pipeline, más abajo.
enum Stage {
  IMPORTED
  PROPOSAL_GENERATED
  IN_REVIEW
  APPROVED
  APPLIED
  MEASURED
}

// Publicación: el producto armado para una tienda puntual.
model Publication {
  id                String               @id @default(cuid())
  productId         String
  product           Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId           String
  store             Store                @relation(fields: [storeId], references: [id])
  externalId        String? // por ejemplo MLA123456
  url               String?
  title             String?
  description       String?
  // Atributos tal como se cargan en el canal: lista de { name, value }.
  attributes        Json                 @default("[]")
  // Las preguntas de los compradores en esta publicación, pegadas tal cual.
  // Las de la competencia son del producto (ProductResearch).
  ownQuestions      String?
  // Precio público del canal. Nunca costos ni listas de proveedor.
  price             Decimal?             @db.Decimal(14, 2)
  currency          String               @default("ARS")
  channelStatus     ChannelStatus        @default(ACTIVE)
  // Estado de la propuesta completa con IA.
  stage             Stage                @default(IMPORTED)
  // Pipeline: dónde está y en qué paso. El paso se conserva al sacarla del
  // pipeline, para retomar ahí si se vuelve a agregar.
  pipelineStatus    PipelineStatus       @default(UNTOUCHED)
  pipelineStep      PipelineStep?
  pipelineRemoval   PipelineRemoval?
  // Título bloqueado marcado a mano, para cuando no hay datos de ventas.
  titleLockedManual Boolean?
  // La categoría del canal, cuando se elige a mano. Sin elegir, sale de la
  // familia del producto (src/channels/<canal>/).
  channelCategory   String?
  source            RecordSource         @default(MANUAL)
  // Importación que la creó, para poder deshacerla.
  importRunId       String?
  importRun         ImportRun?           @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  stageMovements    StageMovement[]
  measurements      Measurement[]
  importChanges     ImportChange[]
  proposals         Proposal[]
  applications      ChannelApplication[]
  pipelineMovements PipelineMovement[]
  competitors       CompetitorListing[]
  titleWork         TitleWork?
  titleApprovals    TitleApproval[]
  positions         SearchPosition[]

  @@unique([storeId, externalId])
  @@index([pipelineStatus])
  @@index([productId])
  @@index([importRunId])
  @@map("publications")
}

// Registro de cuándo entra y sale una publicación de cada etapa. Una sola
// fila abierta (exitedAt nulo) por publicación: la etapa actual.
model StageMovement {
  id            String      @id @default(cuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  stage         Stage
  enteredAt     DateTime    @default(now())
  exitedAt      DateTime?
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([publicationId, enteredAt])
  @@map("stage_movements")
}

// ───────────────────────────── Mediciones ─────────────────────────────

// Medición: foto de cómo estaba una publicación en el canal en una fecha.
// Sirve como "antes" para comparar con el "después" de aplicar los cambios.
// Las métricas son una lista abierta (src/domain/measurements.ts) para no
// rehacer la tabla cada vez que se mide algo nuevo.
model Measurement {
  id            String       @id @default(cuid())
  publicationId String
  publication   Publication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  takenAt       DateTime     @db.Date
  source        RecordSource @default(MANUAL)
  metrics       Json         @default("{}")
  importRunId   String?
  importRun     ImportRun?   @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([publicationId, takenAt])
  @@index([importRunId])
  @@map("measurements")
}

// ───────────────────────────── Importador ─────────────────────────────

// Relación guardada entre las columnas de un archivo y los campos de la app.
model ImportMapping {
  id          String      @id @default(cuid())
  accountId   String
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  // Encabezados del archivo con el que se armó, para reconocerlo después.
  headers     Json        @default("[]")
  // Encabezado → campo de la app.
  fields      Json        @default("{}")
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  importRuns  ImportRun[]

  @@unique([accountId, name])
  @@map("import_mappings")
}

enum ImportStatus {
  RUNNING
  DONE
  FAILED
  UNDONE
}

// Qué hace una importación con lo que ya está en la app: solo completa lo
// vacío, o además reemplaza lo que es distinto.
enum ImportUpdateMode {
  FILL_EMPTY
  REPLACE
}

// De dónde vienen las filas: un archivo, o el canal leído con la cuenta conectada.
enum ImportOrigin {
  FILE
  CHANNEL_API
}

// Una importación: quién, cuándo, qué archivo y qué resultó.
model ImportRun {
  id                   String           @id @default(cuid())
  accountId            String
  account              Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  storeId              String
  store                Store            @relation(fields: [storeId], references: [id])
  mappingId            String?
  mapping              ImportMapping?   @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  userId               String?
  user                 User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  origin               ImportOrigin     @default(FILE)
  // Con origin CHANNEL_API, el canal y la tienda.
  fileName             String
  sheetName            String
  dataDate             DateTime         @db.Date
  status               ImportStatus     @default(RUNNING)
  rowsTotal            Int
  rowsProcessed        Int              @default(0)
  productsCreated      Int              @default(0)
  publicationsCreated  Int              @default(0)
  publicationsLinked   Int              @default(0)
  publicationsExisting Int              @default(0)
  measurementsSaved    Int              @default(0)
  updateMode           ImportUpdateMode @default(FILL_EMPTY)
  // Publicaciones o fichas que ya estaban y a las que se les cambió algo.
  publicationsUpdated  Int              @default(0)
  fieldsChanged        Int              @default(0)
  rowsWithErrors       Int              @default(0)
  // Primeros errores, para mostrarlos: lista de { row, message }.
  errors               Json             @default("[]")
  startedAt            DateTime         @default(now())
  finishedAt           DateTime?
  undoneAt             DateTime?
  // Productos que creó y quedaron al deshacer: tenían publicaciones cargadas
  // después o estaban en un combo.
  productsKept         Int              @default(0)
  products             Product[]
  publications         Publication[]
  measurements         Measurement[]
  changes              ImportChange[]

  @@index([accountId, startedAt])
  @@map("import_runs")
}

// ───────────────────────────── Estándar de publicación ─────────────────────────────

// Regla del estándar, por cuenta y canal. "check" es una de las revisiones
// que la app sabe hacer (src/domain/standard.ts) y "params" sus valores,
// por ejemplo { "min": 6 } fotos.
model StandardRule {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id])
  name        String
  description String?
  check       String
  params      Json     @default("{}")
  weight      Int      @default(10)
  active      Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId, channelId, position])
  @@map("standard_rules")
}

// Un campo que una importación cambió en algo que ya estaba: cómo estaba y
// cómo quedó. Deshacer la importación lo devuelve, si nadie lo cambió después.
model ImportChange {
  id            Int          @id @default(autoincrement())
  importRunId   String
  importRun     ImportRun    @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Solo en los campos de la publicación, como el título.
  publicationId String?
  publication   Publication? @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  field         String
  before        Json?
  after         Json?
  createdAt     DateTime     @default(now())

  @@index([importRunId])
  @@index([productId])
  @@map("import_changes")
}

// ───────────────────────────── Propuestas de la IA ─────────────────────────────

enum ProposalStatus {
  ACTIVE // la vigente de la publicación, una sola a la vez
  SUPERSEDED // reemplazada por otra más nueva
  APPROVED
  REJECTED
}

// Propuesta de la IA para una publicación: qué cambiaría, campo por campo.
// No cambia nada por sí sola: se revisa y se aprueba aparte.
model Proposal {
  id            String               @id @default(cuid())
  publicationId String
  publication   Publication          @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  status        ProposalStatus       @default(ACTIVE)
  summary       String
  // Campos que cambian: lista de { field, before, after, reason, toConfirm, placeholders }.
  fields        Json
  // Cómo estaba el contenido cuando se generó, para comparar en la revisión.
  baseline      Json
  // Avisos generales, por ejemplo una medida de un SKU que no está en el producto.
  notes         Json                 @default("[]")
  model         String
  // Tokens y costo aproximado en dólares.
  usage         Json
  createdById   String?
  createdBy     User?                @relation("ProposalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  // Revisión: mientras se revisa, el borrador; al decidir, qué quedó en cada
  // campo, qué había propuesto la IA, si se editó y cómo estaba antes.
  review        Json?
  decidedAt     DateTime?
  decidedById   String?
  decidedBy     User?                @relation("ProposalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  rejectReason  String?
  applications  ChannelApplication[]

  @@index([publicationId, status])
  @@map("proposals")
}

// ───────────────────────────── Aplicación en el canal ─────────────────────────────

// Cada vez que lo aprobado se aplicó en el canal: cuándo, cómo y qué campos.
// La fecha es el punto de partida para medir el antes y el después.
model ChannelApplication {
  id            String      @id @default(cuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  proposalId    String?
  proposal      Proposal?   @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  method        ApplyMethod
  appliedAt     DateTime
  // Campos aplicados: lista de claves, por ejemplo ["title", "specs"].
  fields        Json        @default("[]")
  createdById   String?
  createdBy     User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([publicationId, appliedAt])
  @@map("channel_applications")
}

// ───────────────────────────── Pipeline ─────────────────────────────

// Pasos del pipeline, en orden (src/domain/pipeline.ts).
enum PipelineStep {
  INFO
  TITLE
  IMAGES
  VIDEOS
  MEDIA
  DESCRIPTION
  PUBLISH
}

enum PipelineStatus {
  UNTOUCHED // sin tocar
  IN_PIPELINE
  CORRECTED // terminó el último paso
  DISCARDED // se sacó del pipeline, con su motivo
}

// Por qué salió de un paso.
enum PipelineExit {
  ADVANCED
  BACK
  REMOVED
  COMPLETED
}

// Motivo al sacarla del pipeline.
enum PipelineRemoval {
  NOT_WORTH
  LATER
  DUPLICATE
  PAUSE
}

// Cuándo entra y sale una publicación de cada paso, quién la movió y por qué
// salió. Una sola fila abierta (exitedAt nulo) mientras está en el pipeline.
model PipelineMovement {
  id            String           @id @default(cuid())
  publicationId String
  publication   Publication      @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  step          PipelineStep
  enteredAt     DateTime         @default(now())
  userId        String?
  user          User?            @relation("PipelineMovedIn", fields: [userId], references: [id], onDelete: SetNull)
  exitedAt      DateTime?
  exitKind      PipelineExit?
  removal       PipelineRemoval?
  exitedById    String?
  exitedBy      User?            @relation("PipelineMovedOut", fields: [exitedById], references: [id], onDelete: SetNull)

  @@index([publicationId, enteredAt])
  @@map("pipeline_movements")
}

// ───────────────────────────── Paso Información ─────────────────────────────

// Publicación de la competencia que vende mucho, cargada a mano. Sus títulos
// suman palabras al mapa del paso Título.
model CompetitorListing {
  id            String      @id @default(cuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  url           String?
  title         String
  soldQuantity  Int?
  position      Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([publicationId])
  @@map("competitor_listings")
}

// La investigación del producto que se junta en el paso Información: lo del
// fabricante, las aclaraciones para las imágenes y las preguntas de los
// compradores. Es del producto: la comparten todas sus publicaciones.
model ProductResearch {
  id                     String   @id @default(cuid())
  productId              String   @unique
  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  manufacturerSite       String?
  manufacturerProductUrl String?
  manufacturerText       String?
  // Texto con formato, en HTML limpio: solo negrita, cursiva y listas.
  clarifications         String?
  competitorQuestions    String?
  updatedById            String?
  updatedBy              User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt              DateTime @updatedAt

  @@map("product_research")
}

enum ProductFileKind {
  IMAGE
  PDF
}

// Un archivo del fabricante subido al depósito de archivos.
model ProductFile {
  id           String          @id @default(cuid())
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind         ProductFileKind
  name         String
  contentType  String
  size         Int
  url          String          @unique
  uploadedById String?
  uploadedBy   User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())

  @@index([productId])
  @@map("product_files")
}

enum InsightKind {
  PAIN
  OBJECTION
}

// Un dolor o una objeción de los compradores, en el orden que se eligió.
model BuyerInsight {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      InsightKind
  text      String
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([productId, kind, position])
  @@map("buyer_insights")
}

// ───────────────────────────── Paso Título ─────────────────────────────

// Reglas de título por cuenta y canal. Sin fila, valen las del canal
// (src/channels/<canal>/).
model TitleRuleSet {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channelId      String
  channel        Channel  @relation(fields: [channelId], references: [id])
  maxLength      Int?
  // Signos no permitidos, todos juntos, por ejemplo "!¡*$".
  forbiddenChars String   @default("")
  // Palabras o frases no permitidas: lista de textos.
  forbiddenWords Json     @default("[]")
  // Estructura sugerida por familia: lista de { family, structure }. La
  // familia vacía vale para todas.
  structures     Json     @default("[]")
  updatedById    String?
  updatedBy      User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt      DateTime @updatedAt

  @@unique([accountId, channelId])
  @@map("title_rule_sets")
}

// Qué hacer con un título bloqueado por ventas.
enum TitleLockDecision {
  KEEP // mantener el título: el paso se completa sin cambios
  TRY_IN_COPY // probar el título nuevo en la copia con cuotas
}

// El trabajo del paso Título de una publicación: semillas, palabras elegidas,
// búsquedas principales y propuestas de la IA.
model TitleWork {
  id              String             @id @default(cuid())
  publicationId   String             @unique
  publication     Publication        @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  lockDecision    TitleLockDecision?
  lockDecidedAt   DateTime?
  lockDecidedById String?
  lockDecidedBy   User?              @relation(fields: [lockDecidedById], references: [id], onDelete: SetNull)
  // Lo que se busca en el canal: lista de textos.
  seeds           Json?
  // Palabra → "use" o "discard".
  words           Json               @default("{}")
  // Búsquedas principales para medir la posición: lista de textos.
  mainSearches    Json               @default("[]")
  // Propuestas de la IA: lista de { title, reason }.
  proposals       Json               @default("[]")
  proposalsAt     DateTime?
  proposalUsage   Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("title_works")
}

enum TitleOutcome {
  KEPT // se mantuvo el título
  WRITTEN // el título nuevo quedó en la publicación
  COPY // el título nuevo es para la copia con cuotas
}

// Cada título aprobado: cómo estaba, qué quedó, qué propuso la IA y si la
// persona lo cambió.
model TitleApproval {
  id            String       @id @default(cuid())
  publicationId String
  publication   Publication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  outcome       TitleOutcome
  before        String?
  title         String?
  // La propuesta de la IA que se eligió, si se eligió una.
  aiTitle       String?
  // Las propuestas que había: lista de { title, reason }.
  aiProposals   Json         @default("[]")
  edited        Boolean      @default(false)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([publicationId, createdAt])
  @@map("title_approvals")
}

enum CaptureSource {
  AUTO // leído por la app
  MANUAL // pegado o cargado a mano
}

// Sugerencias del buscador del canal para lo que se escribió, con fecha. Son
// de la cuenta: sirven para todas las publicaciones con la misma semilla.
model SearchSuggestion {
  id            String        @id @default(cuid())
  accountId     String
  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channelId     String
  channel       Channel       @relation(fields: [channelId], references: [id])
  // La semilla y lo que se escribió en el buscador: la semilla, o la semilla
  // más una letra.
  seed          String
  query         String
  // Lista de textos, en el orden del buscador.
  suggestions   Json
  source        CaptureSource
  publicationId String?
  capturedAt    DateTime      @default(now())

  @@index([accountId, channelId, seed])
  @@map("search_suggestions")
}

// En qué página y posición aparece la publicación al buscar algo, con fecha.
// Sin página: no aparece en las páginas revisadas.
model SearchPosition {
  id            String        @id @default(cuid())
  publicationId String
  publication   Publication   @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  query         String
  page          Int?
  position      Int?
  pagesChecked  Int           @default(3)
  source        CaptureSource
  checkedAt     DateTime      @default(now())

  @@index([publicationId, checkedAt])
  @@map("search_positions")
}

// Prueba de conexión con un canal: si la app puede leer cada cosa.
model ChannelProbe {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id])
  // Las pruebas con la cuenta conectada son de una tienda; las demás, del canal.
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  check     String
  ok        Boolean
  detail    String
  checkedAt DateTime @default(now())

  @@index([channelId, check, checkedAt])
  @@map("channel_probes")
}

// ───────────────────────────── Conexión con el canal ─────────────────────────────

enum ConnectionStatus {
  NOT_CONNECTED // hay datos de la aplicación, todavía sin autorizar
  ACTIVE
  NEEDS_REAUTH // la renovación falló: hay que volver a autorizar
}

// La conexión de una tienda con su canal por API. Cada cliente crea su propia
// aplicación en el canal y la autoriza con su cuenta. Las claves y las llaves
// se guardan cifradas (src/lib/crypto.ts) y nunca se muestran.
model ChannelConnection {
  id               String           @id @default(cuid())
  storeId          String           @unique
  store            Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // La aplicación del cliente en el canal.
  appId            String
  appSecret        String
  // Los últimos 4 caracteres de la clave secreta, para reconocerla.
  appSecretHint    String
  status           ConnectionStatus @default(NOT_CONNECTED)
  // La cuenta del canal que autorizó.
  externalUserId   String?
  externalNickname String?
  accessToken      String?
  refreshToken     String?
  expiresAt        DateTime?
  scope            String?
  connectedAt      DateTime?
  connectedById    String?
  connectedBy      User?            @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  lastRefreshAt    DateTime?
  lastError        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("channel_connections")
}

// Un pedido de autorización en curso. El código de control (state) va y
// vuelve del canal, y dice de qué tienda era. Se usa una sola vez y vence.
model ConnectAttempt {
  id           String    @id @default(cuid())
  state        String    @unique
  // El secreto de PKCE, cifrado.
  codeVerifier String
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([storeId])
  @@map("connect_attempts")
}

// ───────────────────────────── Conexión con Claude (MCP) ─────────────────────────────

// Un programa que pidió conectarse, por ejemplo Claude en claude.ai. Se
// registra solo la primera vez (registro dinámico de OAuth).
model McpClient {
  id           String        @id
  name         String?
  // Direcciones de vuelta que declaró: lista de textos.
  redirectUris Json          @default("[]")
  createdAt    DateTime      @default(now())
  codes        McpAuthCode[]
  tokens       McpToken[]

  @@map("mcp_clients")
}

// El código que recibe Claude cuando la persona toca Autorizar. Se cambia por
// la llave una sola vez y vence a los 10 minutos. Se guarda solo su huella.
model McpAuthCode {
  id            String     @id @default(cuid())
  codeHash      String     @unique
  clientId      String?
  client        McpClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime   @default(now())
  tokens        McpToken[]

  @@map("mcp_auth_codes")
}

// La llave con la que Claude usa la app en nombre de una persona. Vale 30
// días y se puede cortar desde Equipo. Se guarda solo su huella.
model McpToken {
  id         String       @id @default(cuid())
  tokenHash  String       @unique
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId   String?
  client     McpClient?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName String
  codeId     String?
  code       McpAuthCode? @relation(fields: [codeId], references: [id], onDelete: SetNull)
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())

  @@index([userId])
  @@map("mcp_tokens")
}
