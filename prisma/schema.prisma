// Modelo de datos de E-commerce Studio MRB.
//
// La regla central: el producto es la fuente única de verdad. Un canal
// (Mercado Libre, tienda web) solo muestra el producto a través de una
// Publicación. Nunca se guardan datos del producto "dentro" de la publicación
// salvo lo que es propio del canal (título, descripción y atributos tal como
// se muestran ahí, precio, ID externo).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Login (Better Auth) ─────────────────────────────
// Los usuarios son del equipo del estudio y ven todas las cuentas.

model User {
  id             String          @id
  name           String
  email          String          @unique
  emailVerified  Boolean         @default(false)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  sessions       Session[]
  authAccounts   AuthAccount[]
  stageMovements StageMovement[]
  importRuns     ImportRun[]
  importMappings ImportMapping[]
  proposals      Proposal[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Credenciales de login de cada usuario. Better Auth lo llama "account"; acá
// se renombra para no confundirlo con Account, que es la cuenta del cliente.
model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ───────────────────────────── Cuentas y canales ─────────────────────────────

// Cuenta: el cliente del estudio. Todo dato pertenece a una cuenta.
model Account {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  timezone       String          @default("America/Argentina/Buenos_Aires")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stores         Store[]
  products       Product[]
  importMappings ImportMapping[]
  importRuns     ImportRun[]
  standardRules  StandardRule[]

  @@map("accounts")
}

enum ChannelKind {
  MERCADOLIBRE
  WEB_STORE
}

// Canal: lista fija de lugares donde se puede mostrar un producto.
model Channel {
  id            String         @id @default(cuid())
  kind          ChannelKind    @unique
  name          String
  stores        Store[]
  standardRules StandardRule[]

  @@map("channels")
}

// Forma de llevar una publicación aprobada al canal. Hoy es manual; mañana
// puede ser una planilla masiva o la API del canal, sin tocar el resto.
enum ApplyMethod {
  MANUAL
  SPREADSHEET
  API
}

// Tienda: la presencia de una cuenta en un canal. Por ejemplo, Insur en
// Mercado Libre es la tienda INSURMOTOR.
model Store {
  id               String        @id @default(cuid())
  accountId        String
  account          Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channelId        String
  channel          Channel       @relation(fields: [channelId], references: [id])
  name             String
  externalSellerId String?
  applyMethod      ApplyMethod   @default(MANUAL)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  publications     Publication[]
  importRuns       ImportRun[]

  @@unique([accountId, channelId, name])
  @@map("stores")
}

// ───────────────────────────── Producto (ficha maestra) ─────────────────────────────

// De dónde vino un registro: cargado a mano o por el importador.
enum RecordSource {
  MANUAL
  IMPORT
}

model Product {
  id              String           @id @default(cuid())
  accountId       String
  account         Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name            String
  brand           String? // marca del repuesto
  partNumber      String? // nº de pieza u OEM
  productType     String? // tipo de producto, por ejemplo "Kit de embrague"
  engineSystem    String? // sistema del motor, por ejemplo "Distribución"
  line            String? // línea, por ejemplo "Liviano nafta"
  origin          String? // país de origen
  warranty        String?
  kitContents     String?
  // Ficha técnica: lista de { name, value }.
  specs           Json             @default("[]")
  notes           String?
  source          RecordSource     @default(MANUAL)
  // Importación que lo creó, para poder deshacerla.
  importRunId     String?
  importRun       ImportRun?       @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  variants        ProductVariant[]
  compatibilities Compatibility[]
  assets          Asset[]
  publications    Publication[]
  importChanges   ImportChange[]

  @@index([accountId])
  @@index([importRunId])
  @@map("products")
}

// Variante por medida, por ejemplo STD, 0.25 o 0.50, cada una con su SKU.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  measure   String?
  sku       String?
  position  Int     @default(0)

  @@index([productId])
  @@map("product_variants")
}

model Compatibility {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleBrand String?
  model        String?
  engine       String?
  yearFrom     Int?
  yearTo       Int?
  note         String?
  position     Int     @default(0)

  @@index([productId])
  @@map("compatibilities")
}

enum AssetKind {
  PHOTO
  VIDEO
}

// Activo: foto o video del producto. En el MVP solo se guarda el link.
model Asset {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      AssetKind
  url       String
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([productId])
  @@map("assets")
}

// ───────────────────────────── Publicación y etapas ─────────────────────────────

// Estado de la publicación dentro del canal.
enum ChannelStatus {
  ACTIVE
  PAUSED
  INACTIVE
  UNPUBLISHED
}

// Etapas del pipeline. Viven en la publicación porque "Aplicado en canal"
// depende del canal.
enum Stage {
  IMPORTED
  PROPOSAL_GENERATED
  IN_REVIEW
  APPROVED
  APPLIED
  MEASURED
}

// Publicación: el producto armado para una tienda puntual.
model Publication {
  id             String          @id @default(cuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId        String
  store          Store           @relation(fields: [storeId], references: [id])
  externalId     String? // por ejemplo MLA123456
  url            String?
  title          String?
  description    String?
  // Atributos tal como se cargan en el canal: lista de { name, value }.
  attributes     Json            @default("[]")
  // Precio público del canal. Nunca costos ni listas de proveedor.
  price          Decimal?        @db.Decimal(14, 2)
  currency       String          @default("ARS")
  channelStatus  ChannelStatus   @default(ACTIVE)
  stage          Stage           @default(IMPORTED)
  source         RecordSource    @default(MANUAL)
  // Importación que la creó, para poder deshacerla.
  importRunId    String?
  importRun      ImportRun?      @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stageMovements StageMovement[]
  measurements   Measurement[]
  importChanges  ImportChange[]
  proposals      Proposal[]

  @@unique([storeId, externalId])
  @@index([productId])
  @@index([importRunId])
  @@map("publications")
}

// Registro de cuándo entra y sale una publicación de cada etapa. Una sola
// fila abierta (exitedAt nulo) por publicación: la etapa actual.
model StageMovement {
  id            String      @id @default(cuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  stage         Stage
  enteredAt     DateTime    @default(now())
  exitedAt      DateTime?
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([publicationId, enteredAt])
  @@map("stage_movements")
}

// ───────────────────────────── Mediciones ─────────────────────────────

// Medición: foto de cómo estaba una publicación en el canal en una fecha.
// Sirve como "antes" para comparar con el "después" de aplicar los cambios.
// Las métricas son una lista abierta (src/domain/measurements.ts) para no
// rehacer la tabla cada vez que se mide algo nuevo.
model Measurement {
  id            String       @id @default(cuid())
  publicationId String
  publication   Publication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  takenAt       DateTime     @db.Date
  source        RecordSource @default(MANUAL)
  metrics       Json         @default("{}")
  importRunId   String?
  importRun     ImportRun?   @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([publicationId, takenAt])
  @@index([importRunId])
  @@map("measurements")
}

// ───────────────────────────── Importador ─────────────────────────────

// Relación guardada entre las columnas de un archivo y los campos de la app.
model ImportMapping {
  id          String      @id @default(cuid())
  accountId   String
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  // Encabezados del archivo con el que se armó, para reconocerlo después.
  headers     Json        @default("[]")
  // Encabezado → campo de la app.
  fields      Json        @default("{}")
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  importRuns  ImportRun[]

  @@unique([accountId, name])
  @@map("import_mappings")
}

enum ImportStatus {
  RUNNING
  DONE
  FAILED
  UNDONE
}

// Qué hace una importación con lo que ya está en la app: solo completa lo
// vacío, o además reemplaza lo que es distinto.
enum ImportUpdateMode {
  FILL_EMPTY
  REPLACE
}

// Una importación: quién, cuándo, qué archivo y qué resultó.
model ImportRun {
  id                   String           @id @default(cuid())
  accountId            String
  account              Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  storeId              String
  store                Store            @relation(fields: [storeId], references: [id])
  mappingId            String?
  mapping              ImportMapping?   @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  userId               String?
  user                 User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  fileName             String
  sheetName            String
  dataDate             DateTime         @db.Date
  status               ImportStatus     @default(RUNNING)
  rowsTotal            Int
  rowsProcessed        Int              @default(0)
  productsCreated      Int              @default(0)
  publicationsCreated  Int              @default(0)
  publicationsLinked   Int              @default(0)
  publicationsExisting Int              @default(0)
  measurementsSaved    Int              @default(0)
  updateMode           ImportUpdateMode @default(FILL_EMPTY)
  // Publicaciones o fichas que ya estaban y a las que se les cambió algo.
  publicationsUpdated  Int              @default(0)
  fieldsChanged        Int              @default(0)
  rowsWithErrors       Int              @default(0)
  // Primeros errores, para mostrarlos: lista de { row, message }.
  errors               Json             @default("[]")
  startedAt            DateTime         @default(now())
  finishedAt           DateTime?
  undoneAt             DateTime?
  products             Product[]
  publications         Publication[]
  measurements         Measurement[]
  changes              ImportChange[]

  @@index([accountId, startedAt])
  @@map("import_runs")
}

// ───────────────────────────── Estándar de publicación ─────────────────────────────

// Regla del estándar, por cuenta y canal. "check" es una de las revisiones
// que la app sabe hacer (src/domain/standard.ts) y "params" sus valores,
// por ejemplo { "min": 6 } fotos.
model StandardRule {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id])
  name        String
  description String?
  check       String
  params      Json     @default("{}")
  weight      Int      @default(10)
  active      Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId, channelId, position])
  @@map("standard_rules")
}

// Un campo que una importación cambió en algo que ya estaba: cómo estaba y
// cómo quedó. Deshacer la importación lo devuelve, si nadie lo cambió después.
model ImportChange {
  id            Int          @id @default(autoincrement())
  importRunId   String
  importRun     ImportRun    @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Solo en los campos de la publicación, como el título.
  publicationId String?
  publication   Publication? @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  field         String
  before        Json?
  after         Json?
  createdAt     DateTime     @default(now())

  @@index([importRunId])
  @@index([productId])
  @@map("import_changes")
}

// ───────────────────────────── Propuestas de la IA ─────────────────────────────

enum ProposalStatus {
  ACTIVE // la vigente de la publicación, una sola a la vez
  SUPERSEDED // reemplazada por otra más nueva
  APPROVED
  REJECTED
}

// Propuesta de la IA para una publicación: qué cambiaría, campo por campo.
// No cambia nada por sí sola: se revisa y se aprueba aparte.
model Proposal {
  id            String         @id @default(cuid())
  publicationId String
  publication   Publication    @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  status        ProposalStatus @default(ACTIVE)
  summary       String
  // Campos que cambian: lista de { field, before, after, reason, toConfirm, placeholders }.
  fields        Json
  // Cómo estaba el contenido cuando se generó, para comparar en la revisión.
  baseline      Json
  // Avisos generales, por ejemplo una medida de un SKU que no está en el producto.
  notes         Json           @default("[]")
  model         String
  // Tokens y costo aproximado en dólares.
  usage         Json
  createdById   String?
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())

  @@index([publicationId, status])
  @@map("proposals")
}
