{
  "manifest_version": 3,
  "name": "Studio MRB · Clips a Mercado Libre",
  "description": "Carga en Mercado Libre los clips aprobados en E-commerce Studio MRB, desde tu propio Chrome.",
  "version": "0.1.2",
  "permissions": ["storage"],
  "host_permissions": ["https://e-commerce.studiomrb.com/*", "https://www.mercadolibre.com.ar/*", "https://vendedores.mercadolibre.com.ar/*"],
  "background": { "service_worker": "fondo.js" },
  "content_scripts": [
    { "matches": ["https://e-commerce.studiomrb.com/*"], "js": ["app.js"], "run_at": "document_start" },
    { "matches": ["https://www.mercadolibre.com.ar/*", "https://vendedores.mercadolibre.com.ar/*"], "js": ["pantalla.js", "mercadolibre.js"], "run_at": "document_idle" }
  ]
}
