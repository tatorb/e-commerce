# Conexión a la base de datos. En Vercel la carga sola la integración de Neon.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/ecommerce_dev"
# Opcional. Conexión directa, sin pool, para aplicar migraciones. Neon la
# carga como DATABASE_URL_UNPOOLED.
DATABASE_URL_UNPOOLED=""

# Clave secreta del login. Una frase larga al azar, de 32 caracteres o más.
BETTER_AUTH_SECRET=""
# Dirección pública de la app. En Vercel no hace falta, se toma sola.
BETTER_AUTH_URL="http://localhost:3000"

# Clave de la API de Claude, para las propuestas con IA. Sin ella, los botones aparecen apagados.
ANTHROPIC_API_KEY=""

# Clave para guardar cifradas las conexiones con los canales (claves de las
# aplicaciones y llaves de acceso). Un texto largo al azar; la pantalla
# Ajustes, Conexión, la genera. Si cambia, hay que volver a conectar todo.
CHANNEL_TOKEN_KEY=""

# Clave de la lectura automática de los canales (/api/sincronizar). Un texto
# largo al azar. El mismo valor va como secreto CRON_SECRET en GitHub, para que
# lea cada hora. Sin ella, solo se lee con el botón Leer ahora.
CRON_SECRET=""

# Opcional. Otras direcciones a las que puede volver el permiso de la conexión
# con Claude, separadas por comas. Las de claude.ai y las de la propia
# computadora ya están permitidas.
MCP_OAUTH_REDIRECT_URIS=""

# Depósito de archivos de Vercel (Vercel Blob), para los archivos del
# fabricante y las fotos del paso Imágenes. Al conectar el depósito al
# proyecto, en la pestaña Storage, Vercel agrega solo BLOB_STORE_ID y la app
# entra con el permiso automático de Vercel (OIDC). En una computadora se puede
# usar la clave del depósito en lugar de las dos primeras.
BLOB_STORE_ID=""
BLOB_WEBHOOK_PUBLIC_KEY=""
BLOB_READ_WRITE_TOKEN=""
